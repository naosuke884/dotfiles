#!/usr/bin/env python3
"""herdr-app の通知をデスクトップ通知(mako)に出し、クリックされたら該当箇所へ移動する。

herdr-app の my-toast mod から、ウィンドウが前面にないときに呼ばれる:
  herdr-notify-focus <title> <body> <level> [<action-json>]
<action-json> は herdr の通知 action ({"name": "agent.focus", "args": {...}})。

すぐに戻り、通知の待ち受けは切り離した子プロセスで行う(mod の exec をふさがないため)。
クリックされたら herdr-app のウィンドウを niri で前面に出し、action を herdr-app do で実行する。
"""
import json
import os
import subprocess
import sys

URGENCY = {"error": "critical", "warning": "normal", "success": "normal", "info": "low"}


def main():
    title = sys.argv[1] if len(sys.argv) > 1 else "Herdr"
    body = sys.argv[2] if len(sys.argv) > 2 else ""
    level = sys.argv[3] if len(sys.argv) > 3 else "info"
    try:
        action = json.loads(sys.argv[4]) if len(sys.argv) > 4 and sys.argv[4] else None
    except json.JSONDecodeError:
        action = None

    # Detach: the caller (herdr-app exec) returns at once.
    if os.fork() > 0:
        return
    os.setsid()
    if os.fork() > 0:
        os._exit(0)

    r = subprocess.run(
        ["notify-send", "--app-name=Herdr", "--hint=string:desktop-entry:herdr-app",
         f"--urgency={URGENCY.get(level, 'normal')}", "--action=default=Open", title, body],
        capture_output=True, text=True,
    )
    if r.stdout.strip() != "default":
        return  # dismissed or expired

    try:
        windows = json.loads(subprocess.run(["niri", "msg", "-j", "windows"], capture_output=True, text=True).stdout)
        herdr = [w for w in windows if w.get("app_id") == "herdr-app"]
        if herdr:
            subprocess.run(["niri", "msg", "action", "focus-window", "--id", str(herdr[0]["id"])])
    except Exception:
        pass
    if action and action.get("name"):
        subprocess.run(["herdr-app", "do", action["name"], json.dumps(action.get("args") or {})],
                       capture_output=True)


if __name__ == "__main__":
    main()
